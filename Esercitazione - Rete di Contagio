Esercitazione - Rete di Contagio

CREATE
  (mario:Persona {nome: "Mario", ruolo: "paziente zero"}),
  (luca:Persona {nome: "Luca", ruolo: "impiegato"}),
  (sara:Persona {nome: "Sara", ruolo: "impiegato"}),
  (anna:Persona {nome: "Anna", ruolo: "manager"}),
  (paolo:Persona {nome: "Paolo", ruolo: "impiegato"}),
  (giulia:Persona {nome: "Giulia", ruolo: "manager"}),
  (marco:Persona {nome: "Marco", ruolo: "esterno"}),

  (mario)-[:HA_CONTAGIATO]->(luca),
  (mario)-[:HA_CONTAGIATO]->(sara),
  (luca)-[:HA_CONTAGIATO]->(anna),
  (sara)-[:HA_CONTAGIATO]->(paolo),
  (anna)-[:HA_CONTAGIATO]->(giulia),
  (paolo)-[:HA_CONTAGIATO]->(marco)

  MATCH p=()-[:HA_CONTAGIATO]->() RETURN p LIMIT 25;

// Le persone contagiate direttamente da Mario
MATCH (mario:Persona {nome: "Mario"})-[:HA_CONTAGIATO]->(diretto)
RETURN diretto.nome AS Contagiato_Diretto


// Le persone raggiunte dal contagio entro 2 passaggi  da Mario.
MATCH (mario:Persona {nome: "Mario"})-[:HA_CONTAGIATO*2]->(secondo_livello)
RETURN secondo_livello.nome AS Contagio_Indiretto


// Le persone raggiunte dal contagio entro 3 passaggi da Mario, escludendo Mario stesso dal risultato
MATCH (mario:Persona {nome: "Mario"})-[:HA_CONTAGIATO*1..3]->(persona)
RETURN persona.nome AS Catena_Contagio
